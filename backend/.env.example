MARY_DATABASE_URL=postgresql+psycopg://localhost:5432/mary_studio
MARY_STORAGE_ROOT=../storage
MARY_LEGACY_ROOT=..
# WP-06: токен worker API (обязателен; пустое значение отключает API).
MARY_WORKER_TOKEN=change-me
# WP-VOICE-06: SHA-256 бинарника Rhubarb Lip Sync 1.14.0 (по умолчанию путь
# ~/.mary-studio/tools/rhubarb-1.14.0/rhubarb). Значение — по бинарнику, не по архиву;
# без него статус Rhubarb остаётся непроверенным и автотайминг недоступен.
MARY_RHUBARB_SHA256=
